import pandas as pd

data = {
    "Student_ID": [101, 102, 103, 104, 105, 106, 107, 108, 109, 110],
    "Name": [
        "Rahul", "Priya", "Aman", "Sneha", "Vikas",
        "Anjali", "Rohit", "Neha", "Karan", "Pooja"
    ],
    "Age": [18, 19, 18, 20, 19, 18, 21, 19, 20, 18],
    "Gender": [
        "Male", "Female", "Male", "Female", "Male",
        "Female", "Male", "Female", "Male", "Female"
    ],
    "Math": [85, 92, 76, 88, 65, 95, 72, 89, 78, 91],
    "Science": [80, 89, 74, 90, 68, 94, 70, 85, 82, 93],
    "English": [78, 95, 80, 86, 72, 91, 75, 88, 79, 90],
    "Attendance": [90, 95, 82, 88, 75, 98, 80, 92, 85, 96]
}

df = pd.DataFrame(data)

print(df)





print(df.shape)




4---Display all column names.

print(df.columns)  



5---Get basic information about the DataFrame.

print(df.info())



6---Find the highest Science marks.

print(df["Science"].max())




7---Find students whose Math marks are greater than 80.



result = df[df["Math"] > 80]

print(result)




8---Create one calculated columns.


df["Total"] = df["Math"] + df["Science"] + df["English"]

print(df)



9---Average Marks for the subjects.

  
df["Average"] = df["Total"] / 3

print(df)  
  
  


10---Find students who scored more than 80 in Math AND more than 80 in Science.


result = df[(df["Math"] > 80) & (df["Science"] > 80)]

print(result)




11---Find students whose Math marks are greater than 80 AND attendance is greater than 90.

  
result = df[(df["Math"] > 80) & (df["Attendance"] > 90)]

print(result)




12---Find students who scored at least 80 in all three subjects.

  
result = df[(df["Math"] >= 80) & (df["Science"] >= 80) & (df["English"] >= 80)]

print(result)




13---Find students who scored more than 90 in Math OR Science.

  
result = df[(df["Math"] > 90) | (df["Science"] > 90)]

print(result)  




14---Find students whose attendance is below 80 OR Math marks are below 70.

  
result = df[(df["Attendance"] < 80) | (df["Math"] < 70)]

print(result)




15---Find students who have Math marks greater than 80 AND either Science or English marks greater than 90.
  
result = df[(df["Math"] > 80) & ((df["Science"] > 90) | (df["English"] > 90))]

print(result)




